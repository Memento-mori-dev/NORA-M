<button class="nora-disclosure-toggle{{#if previewHover}} nora-disclosure-toggle--preview-hover{{/if}}" type="button" aria-expanded="{{#if expanded}}true{{else}}false{{/if}}"{{#if controls}} aria-controls="{{controls}}"{{/if}}{{#if hidden}} hidden{{/if}}>
  <span class="nora-disclosure-toggle__label--collapsed">Показать все</span>
  <span class="nora-disclosure-toggle__label--expanded">Скрыть</span>
  <span class="nora-disclosure-toggle__icon" aria-hidden="true"></span>
</button>
