<div class="company-reviews__slide swiper-slide">
  <a class="company-reviews__card" href="{{href}}" aria-label="Читать отзыв — {{author}}">
    <blockquote class="company-reviews__quote">{{quote}}</blockquote>

    <div class="company-reviews__byline">
      <img class="company-reviews__avatar" src="/src/assets/company-reviews/{{avatar}}" width="54" height="54" loading="lazy" alt="">
      <div class="company-reviews__author">
        <span class="company-reviews__name">{{author}}</span>
        <span class="company-reviews__rating">
          <img src="/src/assets/company-reviews/rating-star.svg" width="20" height="20" loading="lazy" alt="">
          <span class="visually-hidden">Оценка</span>
          5.0
        </span>
      </div>
      <time class="company-reviews__date" datetime="2026-03">Март 2026</time>
    </div>
  </a>
</div>
