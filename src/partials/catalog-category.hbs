<button class="catalog-menu__link catalog-menu__link--submenu" type="button" aria-controls="catalog-submenu" aria-expanded="false" data-catalog-category="{{key}}">
  <span class="catalog-menu__line"><span class="catalog-menu__text">{{name}}</span></span>
  <picture class="catalog-menu__chevron">
    <source media="(width < 48rem)" srcset="/src/assets/catalog-menu/mobile-chevron.svg">
    <img src="/src/assets/catalog-menu/pc-chevron.svg" alt="">
  </picture>
  <picture class="catalog-menu__chevron catalog-menu__chevron--active">
    <source media="(width < 48rem)" srcset="/src/assets/catalog-menu/mobile-chevron.svg">
    <img src="/src/assets/catalog-menu/pc-chevron-active.svg" alt="">
  </picture>
</button>
