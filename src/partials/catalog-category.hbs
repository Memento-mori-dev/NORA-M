<button class="catalog-menu__link catalog-menu__link--submenu" type="button" aria-controls="catalog-submenu" aria-expanded="false" data-catalog-category="{{key}}">
  <span class="catalog-menu__line"><span class="catalog-menu__text">{{name}}</span></span>
  {{> mobile-picture lazy=true className="catalog-menu__chevron" mobileSrc="/src/assets/catalog-menu/mobile-chevron.svg" fallbackSrc="/src/assets/catalog-menu/pc-chevron.svg" }}
  {{> mobile-picture lazy=true className="catalog-menu__chevron catalog-menu__chevron--active" mobileSrc="/src/assets/catalog-menu/mobile-chevron.svg" fallbackSrc="/src/assets/catalog-menu/pc-chevron-active.svg" }}
</button>
